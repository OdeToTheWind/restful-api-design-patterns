generator client {
  provider = "prisma-client-js"
  // Per-demo output: demos share one @prisma/client install in the pnpm workspace,
  // so the default location would be overwritten by whichever demo generated last.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder resource — replace with the day's real models
model Item {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}
