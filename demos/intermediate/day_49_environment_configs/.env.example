# Every variable the app reads (validated by src/config/schema.ts).
# Copy to .env for local secrets; non-secret per-environment defaults live in
# the committed .env.development / .env.test / .env.production files.
PORT=3049
# development | test | production — set by your shell/Docker, not by .env files
NODE_ENV=development
LOG_LEVEL=info
# Allowed browser origins, comma-separated (production: explicit origins only)
CORS_ORIGIN=
RATE_LIMIT_PER_MINUTE=120
FEATURE_NEW_GREETING=false
# Enables /api/admin/config; required in production (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
