PORT=3033
NODE_ENV=development
# Used by docker-compose.yml to create the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=restful_api_day33
# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://postgres:change-me-local-only@localhost:5432/restful_api_day33?schema=public"
# Redis cache (docker-compose.yml starts one on localhost)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug (default: debug in development, info in production)
# LOG_LEVEL=info
