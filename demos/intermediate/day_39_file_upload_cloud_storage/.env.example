PORT=3039
NODE_ENV=development
# Used by docker-compose.yml to create the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=restful_api_day39
# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://postgres:change-me-local-only@localhost:5432/restful_api_day39?schema=public"
# S3-compatible storage — docker-compose.yml runs SeaweedFS (S3 API on :9000) with these credentials
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_CREATE_BUCKET=true
MAX_UPLOAD_BYTES=5242880
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug (default: debug in development, info in production)
# LOG_LEVEL=info
