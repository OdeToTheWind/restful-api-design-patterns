PORT=3034
NODE_ENV=development
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug. Default per environment: development=debug, test=error, production=info
# LOG_LEVEL=info
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32+-chars
