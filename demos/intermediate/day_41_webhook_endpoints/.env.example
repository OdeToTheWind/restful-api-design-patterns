PORT=3041
NODE_ENV=development
# Used by docker-compose.yml to create the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=restful_api_day41
# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://postgres:change-me-local-only@localhost:5432/restful_api_day41?schema=public"
# Shared secret with the payment provider (32+ chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=replace-me-with-a-long-random-string-of-32+-chars
WEBHOOK_TOLERANCE_SECONDS=300
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug (default: debug in development, info in production)
# LOG_LEVEL=info
