PORT=3029
NODE_ENV=development
# Used by docker-compose.yml to create the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=restful_api_day29
# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://postgres:change-me-local-only@localhost:5432/restful_api_day29?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
AUTH_RATE_LIMIT=10
# Max failed logins per account per 15 minutes (any IP)
LOGIN_ACCOUNT_LIMIT=5
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug (default: debug in development, info in production)
# LOG_LEVEL=info
