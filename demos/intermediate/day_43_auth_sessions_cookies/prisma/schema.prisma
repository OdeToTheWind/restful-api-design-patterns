generator client {
  provider = "prisma-client-js"
  // Per-demo output: demos share one @prisma/client install in the pnpm workspace,
  // so the default location would be overwritten by whichever demo generated last.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

// One row per refresh token. Rotation creates a new row in the same session, so a session
// (one device/browser login) is the set of rows sharing `sessionId`; at most one is active.
model RefreshToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  sessionId        String
  sessionStartedAt DateTime
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  // When this token was issued, i.e. when the session was last used
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}
