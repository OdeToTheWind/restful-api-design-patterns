PORT=3040
NODE_ENV=development
# docker-compose.yml starts Redis (queue) and Mailpit (SMTP 1025, inbox http://localhost:8025)
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Day 40 <no-reply@example.com>"
EMAIL_MAX_ATTEMPTS=5
# Allowed browser origins (comma-separated). Leave empty to block cross-origin requests.
CORS_ORIGIN=
# Optional: error | warn | info | debug (default: debug in development, info in production)
# LOG_LEVEL=info
ADMIN_API_KEY=day40-admin-secret-key
