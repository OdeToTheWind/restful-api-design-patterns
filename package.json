{
  "name": "restful-api-design-patterns",
  "version": "1.0.0",
  "description": "100 Days of Learning RESTful API Design Patterns",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm build && pnpm lint && pnpm format:check && pnpm test:coverage",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "smoke": "bash scripts/smoke-test.sh",
    "smoke:phase1": "bash scripts/smoke/phase-1-core.sh",
    "smoke:phase2": "bash scripts/smoke/phase-2-services.sh",
    "smoke:phase3": "bash scripts/smoke/phase-3-advanced.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-day": "node scripts/new-day.mjs",
    "test:integration": "pnpm -r --if-present run test:integration"
  },
  "keywords": [
    "rest-api",
    "nodejs",
    "typescript",
    "100-days-of-code"
  ],
  "author": "Bhargavi",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.14.0",
    "prettier": "^3.3.3"
  }
}
